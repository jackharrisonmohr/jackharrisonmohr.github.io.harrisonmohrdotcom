---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="404 — Harrison Mohr">
  <div class="max-w-4xl mx-auto px-6 py-32 text-center">
    <p class="text-sm text-muted-light mb-4">404</p>
    <h1 class="font-serif text-4xl font-semibold mb-4">Page not found</h1>
    <p class="text-muted mb-8">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="text-sm text-muted hover:text-text transition-colors duration-300"
    >
      &larr; Back home
    </a>
  </div>
</PageLayout>
