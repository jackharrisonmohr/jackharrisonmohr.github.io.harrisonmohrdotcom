---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="404 — Harrison Mohr">
  <div class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="font-mono text-sm text-accent mb-4">404</p>
    <h1 class="text-3xl font-bold mb-4">Page not found</h1>
    <p class="text-muted mb-8">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="text-sm text-accent hover:underline"
    >
      &larr; Back home
    </a>
  </div>
</PageLayout>
