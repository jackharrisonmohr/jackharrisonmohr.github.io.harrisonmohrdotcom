---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection, render } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<PageLayout
  title="Projects — Harrison Mohr"
  description="Selected engineering projects: AI agents, ML platforms, and production systems."
>
  <div class="max-w-4xl mx-auto px-6 py-20">
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold mb-4">Projects</h1>
    <p class="text-muted text-lg mb-16">
      Selected work spanning AI agent development, ML platform engineering, and
      production systems.
    </p>

    <div class="space-y-20">
      {
        projects.map(async (project) => {
          const { Content } = await render(project);
          return (
            <article id={project.id} class="scroll-mt-24">
              <div class="mb-4">
                <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-2">{project.data.title}</h2>
                <p class="text-sm text-muted">
                  <span class="font-medium text-text/70">
                    {project.data.role}
                  </span>{" "}
                  &middot; {project.data.org} &middot;{" "}
                  <span class="font-mono text-xs">{project.data.dates}</span>
                </p>
              </div>
              <div class="flex flex-wrap gap-x-3 gap-y-1 mb-8">
                {project.data.tech.map((t: string) => (
                  <span class="font-mono text-xs text-muted-light">
                    {t}
                  </span>
                ))}
              </div>
              <div class="prose dark:prose-invert">
                <Content />
              </div>
              {project.data.links && (
                <div class="flex gap-6 mt-8">
                  {project.data.links.github && (
                    <a
                      href={project.data.links.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm text-muted hover:text-text underline decoration-border underline-offset-[3px] hover:decoration-text transition-all duration-300"
                    >
                      GitHub &rarr;
                    </a>
                  )}
                  {project.data.links.live && (
                    <a
                      href={project.data.links.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm text-muted hover:text-text underline decoration-border underline-offset-[3px] hover:decoration-text transition-all duration-300"
                    >
                      Live &rarr;
                    </a>
                  )}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</PageLayout>
