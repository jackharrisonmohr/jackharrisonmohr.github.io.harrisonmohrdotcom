---
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  date: Date;
  readingTime: number;
  author?: string;
}

const { title, subtitle, description, date, readingTime, author = "Harrison Mohr" } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout title={`${title} — Harrison Mohr`} description={description}>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-12">
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h1>
      {
        subtitle && (
          <p class="font-serif text-2xl sm:text-[1.7rem] leading-snug text-muted mb-5">
            {subtitle}
          </p>
        )
      }
      <div class="flex items-center gap-3 text-sm text-muted-light font-mono">
        <span>{author}</span>
        <span>&middot;</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>&middot;</span>
        <span>{readingTime} min read</span>
      </div>
    </header>
    <div class="prose dark:prose-invert prose-lg max-w-none">
      <slot />
    </div>
    <div class="mt-20 pt-8 border-t border-border">
      <a
        href="/writing"
        class="text-sm text-muted hover:text-text transition-colors duration-300"
      >
        &larr; Back to all posts
      </a>
    </div>
  </article>
</PageLayout>
