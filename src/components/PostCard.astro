---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={href} class="group block py-6">
  <time class="text-xs text-muted-light font-mono block mb-2" datetime={date.toISOString()}>
    {formattedDate}
  </time>
  <h3 class="font-serif text-xl font-semibold text-text group-hover:text-text/70 transition-colors duration-300 mb-2">
    {title}
  </h3>
  <p class="text-sm text-muted leading-relaxed">{description}</p>
</a>
