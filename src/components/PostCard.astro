---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={href} class="group block py-5">
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
    <h3 class="font-semibold text-text group-hover:text-accent transition-colors">
      {title}
    </h3>
    <time class="font-mono text-xs text-muted shrink-0" datetime={date.toISOString()}>
      {formattedDate}
    </time>
  </div>
  <p class="text-sm text-muted leading-relaxed">{description}</p>
</a>
