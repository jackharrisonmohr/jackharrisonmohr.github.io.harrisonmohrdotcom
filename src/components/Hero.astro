<section class="min-h-[100dvh] max-w-4xl mx-auto px-6 flex flex-col justify-center relative">
  <div class="pt-12"></div>
  <h1 class="font-serif text-6xl sm:text-7xl lg:text-8xl font-semibold tracking-tight mb-4">
    Harrison Mohr
  </h1>
  <p class="text-xl sm:text-2xl text-muted mb-8">Applied AI Engineer</p>
  <p class="text-base sm:text-lg leading-relaxed text-text/70 max-w-2xl">
    Founding Engineer at <a href="https://maketimeflow.com" target="_blank" rel="noopener noreferrer" class="text-text/90 underline decoration-border underline-offset-[3px] hover:decoration-text transition-all duration-300">MakeTimeFlow</a>,
    building production AI agent systems end-to-end: voice coaching, LLM
