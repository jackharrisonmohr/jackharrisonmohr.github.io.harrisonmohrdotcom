---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-8 not-prose">
  <img
    src={src}
    alt={alt}
    class="rounded-lg border border-border w-full"
    loading="lazy"
  />
  {caption && (
    <figcaption class="text-sm text-muted text-center mt-3">
      {caption}
    </figcaption>
  )}
</figure>
