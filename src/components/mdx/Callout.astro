---
interface Props {
  type?: "info" | "warning" | "tip";
  label?: string;
}

const { type = "info", label } = Astro.props;

const styles = {
  info: "border-text/15 bg-text/[0.03]",
  warning: "callout-warning",
  tip: "callout-tip",
};

const labels = {
  info: "Note",
  warning: "Warning",
  tip: "Tip",
};

const heading = label ?? labels[type];
---

<aside class:list={["rounded-lg border-l-4 px-6 py-5 my-8 not-prose", styles[type]]}>
  <p class="text-xs font-semibold uppercase tracking-widest mb-3 text-muted-light">
    {heading}
  </p>
  <div class="callout-body text-[1.0625rem] leading-relaxed text-text/90">
    <slot />
  </div>
</aside>

<style>
  .callout-warning {
    border-color: var(--color-callout-warning-border);
    background-color: var(--color-callout-warning-bg);
  }
  .callout-tip {
    border-color: var(--color-callout-tip-border);
    background-color: var(--color-callout-tip-bg);
  }
  /* not-prose strips paragraph margins; restore comfortable spacing between them */
  .callout-body :global(p + p) {
    margin-top: 0.85em;
  }
  .callout-body :global(strong) {
    font-weight: 600;
  }
</style>
