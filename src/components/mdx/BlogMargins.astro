---
// Progressive-enhancement gutters for a long post.
//   • Left gutter  → a sticky, clickable table of contents (h2/h3).
//   • Right gutter → the post's footnotes, relocated as margin notes.
// Below ~1300px there is no room for gutters, so the ToC is hidden and each
// footnote reference becomes a click-to-expand inline panel. With JS disabled
// nothing here runs and the article renders normally (incl. bottom footnotes).
---

<div class="blog-margins-mount" hidden aria-hidden="true"></div>

<script>
  const GUTTER_QUERY = "(min-width: 1300px)";

  function ready(fn: () => void) {
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", fn, { once: true });
    else fn();
  }

  ready(() => {
    const article = document.querySelector("article");
    const prose = article?.querySelector(".prose") as HTMLElement | null;
    if (!article || !prose) return;
    article.classList.add("has-blog-margins");
    (article as HTMLElement).style.position = "relative";
    buildToc(article, prose);
    buildFootnotes(article, prose);
  });

  // ---------------------------------------------------------------- table of contents
  function buildToc(article: Element, prose: HTMLElement) {
    // top-level section headers only (## → h2); keeps the ToC compact
    const heads = Array.from(prose.querySelectorAll<HTMLElement>("h2")).filter(
      (h) => h.id && !h.closest("section[data-footnotes]")
    );
    if (heads.length < 2) return;

    const rail = document.createElement("nav");
    rail.className = "blog-toc";
    rail.setAttribute("aria-label", "Table of contents");

    const inner = document.createElement("div");
    inner.className = "blog-toc-inner";
    const title = document.createElement("p");
    title.className = "blog-toc-title";
    title.textContent = "On this page";
    const list = document.createElement("ul");
    inner.append(title, list);
    rail.appendChild(inner);

    const byId = new Map<string, HTMLAnchorElement>();
    heads.forEach((h) => {
      h.style.scrollMarginTop = "1.5rem";
      const li = document.createElement("li");
      li.className = h.tagName === "H3" ? "lvl-3" : "lvl-2";
      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.textContent = (h.textContent || "").trim();
      li.appendChild(a);
      list.appendChild(li);
      byId.set(h.id, a);
    });
    article.appendChild(rail);

    // start the ToC level with the TL;DR callout, not up by the title
    const anchor = prose.querySelector("aside") || heads[0];
    const alignTop = () => {
      const top = anchor.getBoundingClientRect().top - article.getBoundingClientRect().top;
      rail.style.top = Math.max(0, Math.round(top)) + "px";
    };
    alignTop();
    window.addEventListener("load", () => requestAnimationFrame(alignTop));
    window.addEventListener("resize", () => requestAnimationFrame(alignTop));

    // highlight whichever heading is nearest the top of the viewport
    let current: HTMLAnchorElement | null = null;
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const a = byId.get((e.target as HTMLElement).id);
          if (!a) continue;
          if (current) current.classList.remove("active");
          a.classList.add("active");
          current = a;
        }
      },
      { rootMargin: "-8% 0px -82% 0px", threshold: 0 }
    );
    heads.forEach((h) => obs.observe(h));
  }

  // ---------------------------------------------------------------- footnotes
  function buildFootnotes(article: Element, prose: HTMLElement) {
    const section = prose.querySelector<HTMLElement>("section[data-footnotes]");
    const refs = Array.from(prose.querySelectorAll<HTMLAnchorElement>("a[data-footnote-ref]"));
    if (!section || !refs.length) return;

    const rail = document.createElement("div");
    rail.className = "blog-fn-rail";
    rail.setAttribute("aria-hidden", "true"); // duplicates the still-present source list
    article.appendChild(rail);

    const mq = window.matchMedia(GUTTER_QUERY);
    const notes: { ref: HTMLElement; note: HTMLElement }[] = [];

    refs.forEach((ref) => {
      const href = ref.getAttribute("href") || "";
      const li = href ? section.querySelector(href) : null;
      if (!li) return;
      const num = (ref.textContent || "").trim();

      const body = li.cloneNode(true) as HTMLElement;
      body.querySelectorAll("a[data-footnote-backref]").forEach((b) => b.remove());
      const html = `<span class="blog-fn-num">${num}</span><div class="blog-fn-body">${body.innerHTML}</div>`;

      // margin note (right gutter, wide screens)
      const note = document.createElement("aside");
      note.className = "blog-fn-note";
      note.innerHTML = html;
      rail.appendChild(note);
      notes.push({ ref, note });

      // inline expand/collapse panel (narrow screens), built on first tap
      let pop: HTMLElement | null = null;
      const block = ref.closest("p, li, blockquote, figcaption") || ref.parentElement!;
      ref.addEventListener("click", (e) => {
        e.preventDefault();
        if (mq.matches) {
          flash(note);
          return;
        }
        if (!pop) {
          pop = document.createElement("div");
          pop.className = "blog-fn-pop";
          pop.innerHTML = `<div class="blog-fn-pop-clip"><div class="blog-fn-card">${html}</div></div>`;
          block.after(pop);
        }
        ref.classList.toggle("fn-open", pop.classList.toggle("open"));
      });
    });

    article.classList.add("blog-fn-ready"); // hides the original bottom section

    // stack the margin notes opposite their references, nudging down to de-overlap
    function layout() {
      if (!mq.matches) return;
      const aTop = (article as HTMLElement).getBoundingClientRect().top + window.scrollY;
      let lastBottom = -1e9;
      for (const { ref, note } of notes) {
        const rTop = ref.getBoundingClientRect().top + window.scrollY - aTop;
        const top = Math.max(rTop, lastBottom + 14);
        note.style.top = top + "px";
        lastBottom = top + note.offsetHeight;
      }
    }
    const relayout = () => requestAnimationFrame(layout);
    window.addEventListener("load", relayout);
    window.addEventListener("resize", relayout);
    mq.addEventListener?.("change", relayout);
    relayout();

    function flash(note: HTMLElement) {
      note.classList.add("flash");
      note.scrollIntoView({ block: "center", behavior: "smooth" });
      setTimeout(() => note.classList.remove("flash"), 1200);
    }
  }
</script>

<style is:global>
  /* ====================== table of contents (left gutter) ====================== */
  .blog-toc {
    display: none;
  }
  @media (min-width: 1300px) {
    .blog-toc {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(100% + 1.25rem);
      width: clamp(150px, calc((100vw - 56rem) / 2 - 2.25rem), 240px);
    }
    .blog-toc-inner {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      padding-right: 0.4rem;
    }
  }
  .blog-toc-title {
    margin: 0 0 0.55rem;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(var(--color-muted-light));
  }
  .blog-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid rgb(var(--color-border));
  }
  .blog-toc li {
    margin: 0;
  }
  .blog-toc a {
    display: block;
    margin-left: -1px;
    padding: 0.2rem 0 0.2rem 0.85rem;
    border-left: 2px solid transparent;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.8rem;
    line-height: 1.35;
    color: rgb(var(--color-muted));
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .blog-toc li.lvl-3 a {
    padding-left: 1.6rem;
    font-size: 0.74rem;
    color: rgb(var(--color-muted-light));
  }
  .blog-toc a:hover {
    color: rgb(var(--color-text));
  }
  .blog-toc a.active {
    color: rgb(var(--color-text));
    border-left-color: rgb(var(--color-text));
    font-weight: 600;
  }

  /* ====================== footnotes ====================== */
  /* once relocated, hide the auto-generated bottom section (kept for no-JS) */
  .blog-fn-ready section[data-footnotes] {
    display: none;
  }

  .blog-fn-rail {
    display: none;
  }
  @media (min-width: 1300px) {
    .blog-fn-rail {
      display: block;
      position: absolute;
      top: 0;
      left: 100%;
      height: 100%;
      margin-left: 1.25rem;
      width: clamp(150px, calc((100vw - 56rem) / 2 - 2.5rem), 250px);
    }
    .blog-fn-note {
      position: absolute;
      left: 0;
      right: 0;
    }
  }
  .blog-fn-note {
    display: flex;
    gap: 0.4rem;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgb(var(--color-muted));
  }
  .blog-fn-note .blog-fn-body {
    border-radius: 4px;
    transition: background-color 0.3s;
  }
  .blog-fn-note.flash .blog-fn-body {
    background: var(--color-callout-warning-bg);
    box-shadow: 0 0 0 6px var(--color-callout-warning-bg);
  }
  .blog-fn-num {
    flex: none;
    font-weight: 700;
    font-size: 0.66rem;
    line-height: 1.7;
    color: rgb(var(--color-text));
  }
  .blog-fn-body {
    min-width: 0;
  }
  .blog-fn-body :first-child {
    margin-top: 0;
  }
  .blog-fn-body :last-child {
    margin-bottom: 0;
  }
  .blog-fn-body p {
    margin: 0 0 0.4rem;
  }
  .blog-fn-body a {
    color: rgb(var(--color-text));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* keep KaTeX from overflowing the narrow column */
  .blog-fn-body .katex {
    font-size: 0.95em;
  }

  /* footnote reference: clickable affordance + open state */
  .prose a[data-footnote-ref] {
    cursor: pointer;
    text-decoration: none;
  }
  .prose a[data-footnote-ref].fn-open {
    background: var(--color-callout-warning-bg);
    border-radius: 3px;
  }

  /* inline expand/collapse panel (narrow screens) */
  .blog-fn-pop {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .blog-fn-pop.open {
    grid-template-rows: 1fr;
  }
  .blog-fn-pop-clip {
    overflow: hidden;
  }
  .blog-fn-card {
    display: flex;
    gap: 0.5rem;
    margin: 0.55rem 0 0.9rem;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--color-callout-warning-border);
    border-radius: 0 6px 6px 0;
    background: var(--color-callout-warning-bg);
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgb(var(--color-text));
  }
  @media (min-width: 1300px) {
    /* on wide screens the margin note is the source of truth */
    .blog-fn-pop {
      display: none;
    }
  }
</style>
