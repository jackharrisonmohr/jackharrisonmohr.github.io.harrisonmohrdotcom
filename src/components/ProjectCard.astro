---
interface Props {
  title: string;
  description: string;
  tech: string[];
  href: string;
}

const { title, description, tech, href } = Astro.props;
---

<a href={href} class="group block p-6 rounded-lg border border-border hover:border-accent/30 transition-colors">
  <h3 class="font-semibold text-text group-hover:text-accent transition-colors mb-2">
    {title}
  </h3>
  <p class="text-sm text-muted leading-relaxed mb-4">{description}</p>
  <div class="flex flex-wrap gap-2">
    {
      tech.map((t) => (
        <span class="font-mono text-xs px-2 py-1 bg-text/5 rounded text-muted">
          {t}
        </span>
      ))
    }
  </div>
</a>
