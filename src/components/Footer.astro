    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
      <p>&copy; {currentYear} Harrison Mohr</p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/jackharrisonmohr"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-text transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/harrisonmohr"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-text transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="mailto:jackharrisonmohr@gmail.com"
          class="hover:text-text transition-colors"
        >
          Email
        </a>
      </div>
    </div>
